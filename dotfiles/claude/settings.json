{
  "model": "fable[1m]",
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-guard.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "catalyst": {
      "source": {
        "source": "github",
        "repo": "TheBranchDriftCatalyst/catalyst-agentic-sdlc"
      }
    },
    "beads-marketplace": {
      "source": {
        "source": "github",
        "repo": "gastownhall/beads"
      }
    }
  },
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "beads@beads-marketplace": true,
    "catalyst-meta@catalyst": true,
    "catalyst-sdlc-framework@catalyst": true,
    "claude-code-setup@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "ticket-workflows-v2@catalyst": true,
    "ticket-workflows@catalyst": true
  }
}
