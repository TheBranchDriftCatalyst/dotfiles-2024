# direnv — .envrc is committed (it holds op:// references, never values;
# rendered by use_onepassword). Real values stay in gitignored .env files.
.direnv/
.env
.env.local

# nix build outputs
result
result-*

# home-manager backups
*.hm-bak

# OS noise
.DS_Store

# root-owned droppings from sudo darwin-rebuild/nh runs in-repo
.cache/
# local pre-nix backup of the old dotbot repo (278M) — never commit
.scratch/dotfiles/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# generated by scripts/clean_vscode_baseline_extensions.sh
.scratch/vscode-extensions-backup-*.txt
