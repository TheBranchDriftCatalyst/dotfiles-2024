# load the dev shell from flake.nix (cached by nix-direnv)
use flake

# repo-local prompt: starship reads this env var, direnv unsets it on exit
export STARSHIP_CONFIG="$PWD/.config/starship.toml"

# secrets: op:// refs in .env.tpl → env vars (use_onepassword comes from
# ~/.config/direnv/lib/onepassword.sh — the "operator" half of the pattern);
# guarded so a machine that hasn't switched yet still gets a working shell
if declare -F use_onepassword >/dev/null; then
  use_onepassword .env.tpl
else
  log_error "use_onepassword not provisioned (run dotfiles switch) — secrets NOT loaded"
fi

# secrets, file flavour: some tools only read credentials from a config file.
# use_onepassword_tpl renders the WHOLE template to a gitignored 0600 file
# (default output = template minus .tpl) and exports nothing — you point the
# tool at it yourself, below. It refuses to render to a path that is inside
# this repo and not gitignored. (use_onepassword_file, same library, is the
# other file flavour: op://ref → dest for a single whole-file secret.)
if declare -F use_onepassword_tpl >/dev/null; then
  use_onepassword_tpl .npmrc.tpl
  # npm/pnpm/yarn have no env var for a per-registry token, only a config
  # file; this keeps the rendered one repo-local instead of in ~/.npmrc
  export NPM_CONFIG_USERCONFIG="$PWD/.npmrc"

  # rendering outside the repo works too, for tools with a fixed path —
  # e.g. a kubeconfig assembled from vaulted cluster creds:
  #   use_onepassword_tpl kubeconfig.tpl "$PWD/.secrets/kubeconfig"
  #   export KUBECONFIG="$PWD/.secrets/kubeconfig"
else
  log_error "use_onepassword_tpl not provisioned (run dotfiles switch) — .npmrc NOT rendered"
fi

# un-vaulted local overrides (gitignored) — wins over .env.tpl values
dotenv_if_exists .env.local

# auto-install project deps on entry — mtime-guarded so it's a no-op
# unless a manifest or lockfile changed since the last install
if [ ! -d backend/.venv ] ||
  [ backend/pyproject.toml -nt backend/.venv ] ||
  [ backend/uv.lock -nt backend/.venv ]; then
  (cd backend && uv sync) && touch backend/.venv
fi

if [ ! -d frontend/node_modules ] ||
  [ frontend/package.json -nt frontend/node_modules ] ||
  [ frontend/pnpm-lock.yaml -nt frontend/node_modules ]; then
  (cd frontend && pnpm install) && touch frontend/node_modules
fi
